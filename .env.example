# ── Supabase (fill these in when the Supabase project is created) ────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Media storage driver ─────────────────────────────────────────────────────
# "local"    → uploads are written to ./var/ on this machine (default, no setup)
# "supabase" → uploads go to the Supabase "site-assets" storage bucket
#              (requires the keys above + running supabase/schema.sql once)
STORAGE_DRIVER=local

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Each must be a user created in
# Supabase → Authentication → Users. Server-only.
ADMIN_EMAILS=

# ── Measurement & brand presence ──────────────────────────────────────────────
# All optional — each renders nothing when unset, so previews stay untracked.
# GA4 property (Admin → Data streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta pixel / dataset ID (Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
